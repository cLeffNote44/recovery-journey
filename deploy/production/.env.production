# ==============================================
# Recovery Journey - Production Environment
# ==============================================
# DO NOT COMMIT REAL VALUES - Use GitHub Secrets
# This file serves as a template for production deployment
# ==============================================

# Application
NODE_ENV=production
APP_NAME=recovery-journey
APP_VERSION=${VERSION:-1.0.0}
LOG_LEVEL=info

# Server
HOST=0.0.0.0
PORT=3000
API_URL=https://api.recoveryjourney.app

# Database (Use GitHub Secrets for actual values)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}?schema=public&connection_limit=20&pool_timeout=30

# Authentication (Use GitHub Secrets for actual values)
JWT_SECRET=${JWT_SECRET}
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS - Production domains only
CORS_ORIGIN=https://recoveryjourney.app,https://admin.recoveryjourney.app

# Rate Limiting - Stricter in production
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Feature Flags - Disabled in production
ENABLE_DEBUG_ENDPOINTS=false
ENABLE_SWAGGER=false
ENABLE_METRICS=true

# Monitoring
SENTRY_DSN=${SENTRY_DSN}
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Email (Use GitHub Secrets for actual values)
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=587
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}
EMAIL_FROM=noreply@recoveryjourney.app

# Storage (Use GitHub Secrets for actual values)
AWS_REGION=us-east-1
AWS_S3_BUCKET=recovery-journey-production
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}

# Redis (for session/cache)
REDIS_URL=redis://${REDIS_HOST}:6379

# HIPAA Compliance - Strict settings for production
ENCRYPTION_KEY=${ENCRYPTION_KEY}
AUDIT_LOG_ENABLED=true
SESSION_TIMEOUT_MINUTES=15
REQUIRE_MFA=true
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# SSL/TLS
FORCE_SSL=true
HSTS_MAX_AGE=31536000

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=90
