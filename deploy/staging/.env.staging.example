# ==============================================
# Recovery Journey - Staging Environment Template
# ==============================================
# Copy this file to /opt/recovery-journey/.env on the staging server
# and fill in real values. docker compose reads `.env` from the project
# root automatically for variable substitution.
#
# DO NOT COMMIT REAL VALUES. The `.env` file is gitignored.
# Values must be unquoted (KEY=value, not KEY="value").
#
# Every variable below is either consumed by docker-compose.prod.yml
# (which passes it to the backend container) or by scripts/backup.sh.
# The backend validates its environment at startup and exits if a
# required value is missing or invalid (see Backend/src/config/env.ts).
# ==============================================

# Application
# NODE_ENV must be one of: development | production | test — "staging"
# is NOT valid and crashes the backend at startup. Staging servers run
# in production mode; they differ only in configuration values.
NODE_ENV=production

# Server — the backend listens on 8000 (compose maps BACKEND_PORT:8000)
PORT=8000
HOST=0.0.0.0
BACKEND_PORT=8000

# Backend image (set BACKEND_IMAGE_TAG per deploy; the deploy pipeline
# and scripts/deploy.sh export it automatically)
BACKEND_IMAGE=ghcr.io/cleffnote44/recovery-journey/backend

# Database (compose creates the db container with these)
DB_USER=recovery_staging
DB_PASSWORD=<strong-password>
DB_NAME=recovery_journey

# Connection string used by the backend & migrations.
# `db` is the compose service hostname — do not use localhost.
DATABASE_URL=postgresql://recovery_staging:<strong-password>@db:5432/recovery_journey?schema=public

# Authentication (generate with: openssl rand -hex 64)
JWT_SECRET=<64-char-hex>
JWT_REFRESH_SECRET=<64-char-hex>
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated allowed origins (the variable is CORS_ORIGINS,
# plural; the backend fails to start without it)
CORS_ORIGINS=https://staging.recoveryjourney.app,https://staging-admin.recoveryjourney.app

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Registration keys
REGISTRATION_KEY_EXPIRES_HOURS=72

# HIPAA compliance — REQUIRED (the backend runs in production mode on
# staging and exits without them). Use different values than production.
# (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=<64-char-hex>
ENCRYPTION_SALT=<32-char-hex>
AUDIT_SECRET=<64-char-hex>

# Backups (scripts/backup.sh) — BACKUP_ENCRYPTION_KEY falls back to
# ENCRYPTION_KEY when unset.
BACKUP_ENCRYPTION_KEY=<64-char-hex>
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=
