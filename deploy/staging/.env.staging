# ==============================================
# Recovery Journey - Staging Environment
# ==============================================
# DO NOT COMMIT REAL VALUES - Use GitHub Secrets
# This file serves as a template for staging deployment
# ==============================================

# Application
NODE_ENV=staging
APP_NAME=recovery-journey
APP_VERSION=${VERSION:-1.0.0}
LOG_LEVEL=debug

# Server
HOST=0.0.0.0
PORT=3000
API_URL=https://staging-api.recoveryjourney.app

# Database (Use GitHub Secrets for actual values)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}?schema=public

# Authentication (Use GitHub Secrets for actual values)
JWT_SECRET=${JWT_SECRET}
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=https://staging.recoveryjourney.app,https://staging-admin.recoveryjourney.app

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Feature Flags
ENABLE_DEBUG_ENDPOINTS=true
ENABLE_SWAGGER=true
ENABLE_METRICS=true

# Monitoring
SENTRY_DSN=${SENTRY_DSN:-}
SENTRY_ENVIRONMENT=staging

# Email (Use GitHub Secrets for actual values)
SMTP_HOST=${SMTP_HOST:-}
SMTP_PORT=587
SMTP_USER=${SMTP_USER:-}
SMTP_PASS=${SMTP_PASS:-}
EMAIL_FROM=noreply@staging.recoveryjourney.app

# Storage (Use GitHub Secrets for actual values)
AWS_REGION=us-east-1
AWS_S3_BUCKET=recovery-journey-staging
AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID:-}
AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY:-}

# Redis (for session/cache)
REDIS_URL=redis://${REDIS_HOST:-localhost}:6379

# HIPAA Compliance
ENCRYPTION_KEY=${ENCRYPTION_KEY}
AUDIT_LOG_ENABLED=true
SESSION_TIMEOUT_MINUTES=30
