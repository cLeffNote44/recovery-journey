# =============================================================================
# RECOVERY JOURNEY BACKEND - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://user:password@localhost:5432/recovery_journey?schema=public"

# -----------------------------------------------------------------------------
# JWT CONFIGURATION (SECURITY CRITICAL)
# -----------------------------------------------------------------------------
# Generate secure secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# REQUIREMENTS:
# - Minimum 32 characters (64+ recommended)
# - Cryptographically random
# - Different secrets for JWT_SECRET and JWT_REFRESH_SECRET
# - NEVER reuse secrets across environments

JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
PORT=8000
HOST="0.0.0.0"
NODE_ENV="development"

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
# Be restrictive in production!
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
# Maximum requests per window
RATE_LIMIT_MAX=100
# Window duration in milliseconds (60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# HIPAA COMPLIANCE
# -----------------------------------------------------------------------------
# Audit log retention in days
# HIPAA requires minimum 6 years; we recommend 7 years (2555 days)
AUDIT_LOG_RETENTION_DAYS=2555

# -----------------------------------------------------------------------------
# REGISTRATION
# -----------------------------------------------------------------------------
# How long registration keys remain valid (in hours)
REGISTRATION_KEY_EXPIRES_HOURS=72

# -----------------------------------------------------------------------------
# WEBSOCKET
# -----------------------------------------------------------------------------
# Heartbeat interval in milliseconds
WS_HEARTBEAT_INTERVAL_MS=30000

# -----------------------------------------------------------------------------
# PRODUCTION ADDITIONS (uncomment and configure for production)
# -----------------------------------------------------------------------------
# SSL/TLS Configuration
# SSL_KEY_PATH="/path/to/private.key"
# SSL_CERT_PATH="/path/to/certificate.crt"

# Logging
# LOG_LEVEL="info"

# Session Security
# SECURE_COOKIES=true

# Sentry Error Tracking
# SENTRY_DSN="https://your-sentry-dsn"
