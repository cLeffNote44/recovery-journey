# =============================================================================
# RECOVER APP - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# FACILITY INTEGRATION (Required for facility-connected features)
# -----------------------------------------------------------------------------
# Backend API URL - points to Recovery Journey backend
# Use HTTPS in production!
VITE_FACILITY_API_URL=http://localhost:8000/api/v1

# -----------------------------------------------------------------------------
# CLOUD SYNC (Optional)
# -----------------------------------------------------------------------------
# Supabase configuration for cloud backup/sync
# Get these values from https://app.supabase.com -> Project Settings -> API
# Leave empty to use local-only storage

# Your Supabase project URL (e.g., https://xxxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase anon/public key (safe to use in client-side code)
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
# Enable debug mode
VITE_DEBUG=false

# Log level: debug | info | warn | error
VITE_LOG_LEVEL=info
