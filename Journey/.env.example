# =============================================================================
# RECOVER CLINICIAN PORTAL - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local for local development
# DO NOT commit .env files with real values to version control

# =============================================================================
# API CONFIGURATION (Required)
# =============================================================================

# Backend API URL - must be HTTPS in production
VITE_API_URL=http://localhost:8000/api/v1

# =============================================================================
# ERROR TRACKING (Sentry)
# =============================================================================

# Sentry DSN - Get this from your Sentry project settings
# Leave empty to disable error tracking
VITE_SENTRY_DSN=

# Environment identifier for Sentry
# Options: development, staging, production
VITE_SENTRY_ENVIRONMENT=development

# Force enable Sentry in development (for testing)
# Set to 'true' to enable in dev mode
VITE_SENTRY_FORCE_ENABLE=false

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable debug logging
VITE_DEBUG=false

# Enable demo mode (shows demo data banner even when API is available)
VITE_DEMO_MODE=false

# Enable React Query devtools (default: true in development)
VITE_ENABLE_DEVTOOLS=true

# =============================================================================
# BUILD CONFIGURATION
# =============================================================================

# Application log level: debug | info | warn | error
VITE_LOG_LEVEL=info
